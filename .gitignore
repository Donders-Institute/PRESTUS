*~
*.*~
*sh.e*
*sh.o*
*.e[0-9][0-9][0-9][0-9]*
*.o[0-9][0-9][0-9][0-9]*


######################
# Ignore mkdocs site #
######################

site/
# local preview config with page dates (.github/scripts/docs_page_dates.py --out)
mkdocs_dated.yaml

###################
# Matlab specific #
###################
# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Simulink Code Generation
slprj/
sccprj/

# Session info
octave-workspace

# Simulink autosave extension
*.autosave


################
# HCP specific #
################
# Ignore Eclipse Project files
*.project
*.buildpath
*.pydevproject

# Ignore gradient coefficients files. These are sometimes proprietary and
# should not be checked in to a repository.
*.grad


#################
# atom specific #
#################
.ftpconfig


